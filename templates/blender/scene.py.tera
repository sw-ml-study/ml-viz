# Generated by ml-viz. Run with: blender -b --python generated/minimal_scene.py
import bpy, math, random, os
from mathutils import Vector

bpy.ops.object.select_all(action='SELECT'); bpy.ops.object.delete()
scene = bpy.context.scene
scene.frame_start = 1
scene.frame_end = {{ scene.scene.frames }}
scene.render.engine = 'CYCLES'
scene.cycles.samples = 48
scene.render.resolution_x = 1600
scene.render.resolution_y = 900

# Materials. Set both viewport diffuse_color AND a Principled BSDF base color
# so the glTF exporter (which reads node-based PBR inputs) preserves color.
def mat(name, color, roughness=0.6, metallic=0.0):
    m = bpy.data.materials.new(name)
    m.use_nodes = True
    bsdf = m.node_tree.nodes.get('Principled BSDF')
    if bsdf is not None:
        bsdf.inputs['Base Color'].default_value = color
        if 'Roughness' in bsdf.inputs:
            bsdf.inputs['Roughness'].default_value = roughness
        if 'Metallic' in bsdf.inputs:
            bsdf.inputs['Metallic'].default_value = metallic
    m.diffuse_color = color
    return m
white = mat('salt-white',  (0.94, 0.96, 0.98, 1), roughness=0.85)
sand  = mat('light-sand',  (0.92, 0.84, 0.66, 1), roughness=0.95)
teal  = mat('cyan-glass',  (0.10, 0.65, 0.80, 1), roughness=0.30)
blue  = mat('soft-blue',   (0.20, 0.45, 0.85, 1), roughness=0.45)
dark  = mat('dark-text',   (0.05, 0.07, 0.08, 1), roughness=0.50)
red   = mat('accent-red',  (0.90, 0.25, 0.25, 1), roughness=0.40)
green = mat('accent-green',(0.20, 0.75, 0.50, 1), roughness=0.40)
gray  = mat('matte-gray',  (0.55, 0.58, 0.62, 1), roughness=0.85)
# Brown palette for the mountain backdrop, darkest -> lightest.
browns = [
    mat('mountain-umber',  (0.28, 0.18, 0.12, 1), roughness=0.95),
    mat('mountain-sienna', (0.42, 0.26, 0.16, 1), roughness=0.92),
    mat('mountain-clay',   (0.55, 0.36, 0.22, 1), roughness=0.90),
    mat('mountain-tan',    (0.68, 0.50, 0.32, 1), roughness=0.88),
    mat('mountain-sand',   (0.80, 0.66, 0.46, 1), roughness=0.86),
]

# Ground
bpy.ops.mesh.primitive_plane_add(size=22, location=(0,0,-0.02)); bpy.context.object.data.materials.append(sand)

# Stylized mountain backdrop. Each peak picks a brown from the palette;
# taller peaks bias toward darker, denser rock; lighter foothills land in front.
for i in range(16):
    x=-10+i*1.35; h=random.uniform(1.0,3.2); y=7.5+random.uniform(-.35,.35)
    bpy.ops.mesh.primitive_cone_add(vertices=3, radius1=random.uniform(.9,1.7), depth=h, location=(x,y,h/2-0.02), rotation=(0,0,random.uniform(-.2,.2)))
    obj=bpy.context.object; obj.name='distant_mountain'
    # Map height range (1.0-3.2) to palette index; jitter so the line isn't a stripe.
    tier = min(len(browns)-1, max(0, int((h - 1.0) / (3.2 - 1.0) * len(browns) + random.uniform(-0.6, 0.6))))
    obj.data.materials.append(browns[tier])

# Helpers
def cube(name, loc, scale, material):
    bpy.ops.mesh.primitive_cube_add(size=1, location=loc)
    o=bpy.context.object; o.name=name; o.dimensions=scale; bpy.ops.object.transform_apply(location=False, rotation=False, scale=True); o.data.materials.append(material); return o

def label(text, loc, size=.28):
    # Skip empty bodies — Blender otherwise exports a zero-primitive mesh.
    if not text:
        return None
    bpy.ops.object.text_add(location=loc, rotation=(math.radians(68),0,0))
    t=bpy.context.object; t.name='label_'+text.replace(' ','_'); t.data.body=text; t.data.align_x='CENTER'; t.data.size=size; t.data.align_y='CENTER'
    # Small extrude so the text has volume and reads at oblique angles.
    t.data.extrude = 0.01
    t.data.materials.append(dark); return t

def layer_stack(name, pos, layers, lbl, svg=None):
    # The optional `svg` field is for Blender animation renders: it imports an
    # external SVG as curves so titles/diagrams created outside Blender land in
    # the rendered frames. These curves are tagged 'svg_callout_*' and the
    # glTF exporter below excludes them — three.js gets its own DOM/sprite
    # callouts driven by the Yew client.
    x,y,z=pos
    for k in range(layers):
        material = teal if k%2==0 else blue
        cube(f'{name}_layer_{k}', (x,y,z+0.13*k), (2.2,1.55,0.1), material)
    label(lbl, (x,y-1.05,z+0.9))
    if svg and os.path.exists(svg):
        # `bpy.context.selected_objects` is unreliable in batch mode after
        # import_curve.svg; diff scene.objects to find what was added.
        before = {o.name for o in bpy.context.scene.objects}
        bpy.ops.import_curve.svg(filepath=svg)
        imported = [o for o in bpy.context.scene.objects if o.name not in before]
        for o in imported:
            o.name = 'svg_callout_' + name + '_' + o.name
            o.location = (x+1.8, y-0.2, z+1.65)
            o.rotation_euler = (math.radians(70), 0, math.radians(-18))
            o.scale = (0.003, 0.003, 0.003)

def network(name, pos, nodes, lbl):
    x,y,z=pos
    pts=[]
    for i in range(nodes):
        px=x+random.uniform(-1.0,1.0); py=y+random.uniform(-.7,.7); pz=z+random.uniform(-.25,.7); pts.append((px,py,pz))
        bpy.ops.mesh.primitive_uv_sphere_add(segments=16, ring_count=8, radius=.07, location=(px,py,pz)); bpy.context.object.name=f'{name}_node'; bpy.context.object.data.materials.append([red,green,blue][i%3])
    for i in range(nodes*2):
        a,b=random.sample(pts,2); mid=Vector(((a[0]+b[0])/2,(a[1]+b[1])/2,(a[2]+b[2])/2)); diff=Vector((b[0]-a[0],b[1]-a[1],b[2]-a[2]));
        bpy.ops.mesh.primitive_cylinder_add(vertices=8, radius=.012, depth=diff.length, location=mid)
        c=bpy.context.object; c.name=f'{name}_edge'; c.rotation_euler=diff.to_track_quat('Z','Y').to_euler(); c.data.materials.append(gray)
    label(lbl, (x,y-1.0,z+.9), .22)

def ml_cube(name,pos,lbl):
    cube(name, pos, (.75,.75,.75), blue); label(lbl, (pos[0],pos[1]-0.85,pos[2]+.55), .24)

def rag(name,pos,lbl):
    x,y,z=pos
    cube(name+'_base',(x,y,z+.08),(2.3,1.5,.16),white)
    for i in range(6): cube(name+'_doc_'+str(i),(x-0.75+i*.3,y,z+.3),(.22,.45,.12), teal if i%2 else blue)
    network(name+'_mini',(x,y+.15,z+.65),10,'')
    label(lbl,(x,y-1.0,z+.95),.22)

{% for o in scene.objects %}
{% if o.type == "layer_stack" %}layer_stack('{{ o.name }}', {{ o.position }}, {{ o.layers }}, '{{ o.label }}', '{{ o.svg | default(value="") }}')
{% elif o.type == "network_graph" %}network('{{ o.name }}', {{ o.position }}, {{ o.nodes }}, '{{ o.label }}')
{% elif o.type == "ml_cube" %}ml_cube('{{ o.name }}', {{ o.position }}, '{{ o.label }}')
{% elif o.type == "rag_pipeline" %}rag('{{ o.name }}', {{ o.position }}, '{{ o.label }}')
{% endif %}
{% endfor %}

# Camera and light
bpy.ops.object.light_add(type='SUN', location=(0,-3,7)); bpy.context.object.data.energy=2.0
bpy.ops.object.camera_add(location=(6,-8,5), rotation=(math.radians(58),0,math.radians(39)))
cam=bpy.context.object; scene.camera=cam
for frame, loc in [(1,(6,-8,5)), ({{ scene.scene.frames }},(-6,-7,4.8))]:
    scene.frame_set(frame); cam.location=loc; cam.keyframe_insert('location')
# Save the full scene (svg callouts included) for further Blender work and
# for animation video renders.
bpy.ops.wm.save_as_mainfile(filepath='generated/minimal_scene.blend')

# glTF export for the three.js / Yew interactive client. Select everything
# except the svg_callout_* curves — Blender curve fills don't survive glTF
# cleanly (they ship without a material and render as flat black slabs),
# and the interactive client renders its own callouts (tooltips, links,
# billboards) from the scene spec instead.
bpy.ops.object.select_all(action='DESELECT')
for o in bpy.context.scene.objects:
    if not o.name.startswith('svg_callout_'):
        o.select_set(True)
bpy.ops.export_scene.gltf(
    filepath='generated/minimal_scene.glb',
    export_format='GLB',
    use_selection=True,
)
